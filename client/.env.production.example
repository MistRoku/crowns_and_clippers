# Production: set VITE_API_URL to your deployed API URL.
# NOTE: Vite inlines VITE_* values into the client bundle at build time, so
# they are public by design — never put secrets here. On Netlify this file is
# not used; set VITE_API_URL in the dashboard instead
# (Site configuration -> Environment variables). Copy to .env.production
# (git-ignored) only if you build for production locally, e.g.:
# VITE_API_URL=https://crown-clipper-api.onrender.com
VITE_API_URL=https://YOUR-API-URL.onrender.com
