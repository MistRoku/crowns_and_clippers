# Production: set VITE_API_URL to your deployed API URL.
# On Netlify this is overridden by the environment variable you set in the
# dashboard (Site configuration -> Environment variables). Replace the value
# below with your Render/Azure API URL before deploying, e.g.:
# VITE_API_URL=https://crown-clipper-api.onrender.com
VITE_API_URL=https://YOUR-API-URL.onrender.com
